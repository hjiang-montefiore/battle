; Battle — RTS prototype
; Milestone 1-2 from docs/06-architecture.md: deterministic tick loop and the
; sensor solver. This scaffold exists to verify asset import, scale and controls.

config_version=5

[application]
config/name="Battle"
config/description="Sensor-first RTS. See ../docs/"
run/main_scene="res://scenes/proving_ground.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

; The HUD is laid out in absolute pixels, so without a stretch mode it drifts
; on any window that is not 1600x900.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

; docs/06 tick budget: simulation 20-30 Hz. Godot's default is 60, and leaving
; it implicit meant unit movement silently ran at 60 while the sim core ran at
; 20 -- and unit paths are not tick-rate invariant, so the two disagreed.
common/physics_ticks_per_second=20
; Bound catch-up so a stall cannot spiral into a death march.
common/max_physics_steps_per_frame=8

; NOT set: 3d/physics_engine="Dummy". It would guard against RigidBody3D
; creeping in, but docs/06 explicitly allows Godot physics for cosmetic debris,
; and Dummy would silently break that later.

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2

[input]

cam_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

cam_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
